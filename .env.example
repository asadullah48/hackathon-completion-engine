# Personal AI Employee - Environment Variables
# Copy this file to .env and fill in your values

# Anthropic API (for Claude Code orchestration)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API (for backend chat service)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo
MAX_TOKENS=500
TEMPERATURE=0.7

# Vault Configuration
VAULT_PATH=./vault
DROP_FOLDER=/mnt/d/AI-Employee-Inbox

# Backend Configuration
MAX_REQUESTS_PER_MINUTE=10

# Deployment Platforms (optional)
RENDER_API_KEY=your_render_api_key_here

# Engine Configuration
ENGINE_DEBUG=false
ENGINE_LOG_LEVEL=INFO
CURRENT_HACKATHON=h0
