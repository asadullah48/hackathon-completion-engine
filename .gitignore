# --- Privacy: real vault data must never be committed ---
# Only synthetic samples (files with SAMPLE in the name), README.md, .gitkeep
# and the three static sample docs are tracked. Everything the watchers write is ignored.
vault/**
!vault/**/
!vault/**/README.md
!vault/**/*SAMPLE*
!vault/**/.gitkeep
!vault/Dashboard.md
!vault/Business_Goals.md
!vault/Company_Handbook.md
hackathons/vault/**
!hackathons/vault/README.md
hackathons/*/vault/**/*_watcher_state.json
.claude/worktrees/
.claude/settings.local.json
